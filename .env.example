# ---------------------------------------------------------------------------
# GridPulse configuration.
# Copy to `.env` (at the repo root) and edit if you need to. Every value below
# already has a working default baked into the code, and Open-Meteo needs no
# API key, so a fresh clone runs with an empty .env.
# ---------------------------------------------------------------------------

# --- Backend -----------------------------------------------------------------
# SQLite lives in backend/gridpulse.db by default. Point this anywhere SQLAlchemy
# understands if you'd rather use Postgres.
GRIDPULSE_DATABASE_URL=sqlite:///./gridpulse.db

# How long a site's generation forecast is served from cache before we re-hit
# Open-Meteo. Keep this comfortably above the demo length so the UI stays snappy.
GRIDPULSE_CACHE_TTL_MINUTES=20

# Background refresh cadence (APScheduler). Set to 0 to disable the scheduler.
GRIDPULSE_REFRESH_INTERVAL_MINUTES=15

# Months of historical weather pulled per site when building the training set.
GRIDPULSE_HISTORY_MONTHS=15

# Comma-separated browser origins allowed to call the API.
GRIDPULSE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Open-Meteo endpoints. No key, no signup. Override only if you self-host it.
GRIDPULSE_FORECAST_API=https://api.open-meteo.com/v1/forecast
GRIDPULSE_ARCHIVE_API=https://archive-api.open-meteo.com/v1/archive

# --- Frontend ----------------------------------------------------------------
# Also mirrored in frontend/.env.local — Next.js only reads NEXT_PUBLIC_* vars
# from its own directory.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Secrets pattern ---------------------------------------------------------
# Nothing in GridPulse needs a key today, but if you add a paid data source,
# it goes here and never in committed code.
# SOME_VENDOR_API_KEY=
